---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// Tells search engines this site belongs to the author and links their profiles.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: config.site.author,
  url: config.site.url,
  sameAs: config.socials
    .map(({ url }) => url)
    .filter(url => !url.startsWith("mailto:")),
};
---

<Layout>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-14 pb-10 sm:pt-20">
      <h1 class="max-w-xl text-4xl leading-[1.15] font-medium sm:text-5xl">
        Luke Hartley
      </h1>
      <p class="text-muted-foreground mt-5 max-w-xl text-lg leading-relaxed">
        I build things for the web and write about what I learn along the way.
      </p>
      <div class="mt-8 flex items-center gap-x-5">
        <Socials />
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="meta hover:text-accent inline-flex items-center gap-x-1.5"
          title="RSS feed"
        >
          <IconRss width={14} height={14} class="rtl:-rotate-90" />
          RSS
        </a>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="meta">{t.home.featured}</h2>
          <ul class="mt-6">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-6">
          <h2 class="meta">{t.home.recentPosts}</h2>
          <ul class="mt-6">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="border-border mt-2 mb-16 border-t pt-6">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="meta hover:text-accent inline-flex items-center gap-x-1.5"
      >
        {t.home.allPosts}
        <IconArrowRight
          width={14}
          height={14}
          class="inline-block rtl:-rotate-180"
        />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
