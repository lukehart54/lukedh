---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, pubDatetime, timezone: postTimezone } = data;

// The index is a chronological ledger, so the date leads each row.
// Modified dates belong on the post itself, not in the index.
const datetime = dayjs(pubDatetime).tz(postTimezone ?? config.site.timezone);
---

<li class="group border-border border-b last:border-b-0">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="focus-visible:outline-accent block py-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-dashed sm:grid sm:grid-cols-[7.5rem_1fr] sm:gap-x-8"
  >
    <time
      class="meta block pt-1.5 tabular-nums"
      datetime={datetime.toISOString()}
    >
      {datetime.format("DD MMM YYYY")}
    </time>
    <div class="max-sm:mt-2">
      <Heading
        transition:name={toTransitionName(id)}
        class="group-hover:text-accent text-xl leading-snug font-medium transition-colors"
      >
        {title}
      </Heading>
      <p class="text-muted-foreground mt-1.5 leading-relaxed">{description}</p>
    </div>
  </a>
</li>
